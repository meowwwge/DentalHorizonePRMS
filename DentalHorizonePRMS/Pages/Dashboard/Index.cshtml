@page
@model DentalHorizonePRMS.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<div class="min-h-[calc(100vh-80px)] bg-gradient-to-br from-white via-gray-50 to-gray-100 text-gray-800 px-6 py-6 font-poppins">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-6 print:hidden">
        <svg class="w-7 h-7 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h18v18H3V3z" />
        </svg>
        <h1 class="text-3xl font-bold text-gray-800">Dashboard</h1>
    </div>

    <!-- Description -->
    <p class="text-sm text-gray-600 mb-10 max-w-3xl print:hidden">
        Overview of patient activity, appointments, and clinic metrics.
    </p>

    <!-- Dashboard Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Total Patients -->
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 shadow-md hover:shadow-lg hover:border-blue-400 transition duration-300 print:hidden">
            <h2 class="text-xl font-semibold text-blue-900 mb-2">Total Patients</h2>
            <p class="text-sm text-gray-700 mb-4">View all registered patients in the system.</p>
            <p id="totalPatients" class="text-4xl font-bold text-blue-800 mb-4">0</p>
            <a href="/PatientManagement" class="inline-block px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded hover:bg-blue-700 transition">
                View Details
            </a>
        </div>

        <!-- Upcoming Appointments -->
        <div class="bg-green-50 border border-green-200 rounded-xl p-6 shadow-md hover:shadow-lg hover:border-green-400 transition duration-300 print:hidden">
            <h2 class="text-xl font-semibold text-green-900 mb-2">Upcoming Appointments</h2>
            <p class="text-sm text-gray-700 mb-4">See scheduled visits for today and beyond.</p>
            <p id="upcomingAppointments" class="text-4xl font-bold text-green-800 mb-4">0</p>
            <a href="/Appointments/Upcoming" class="inline-block px-4 py-2 bg-green-600 text-white text-sm font-semibold rounded hover:bg-green-700 transition print:hidden">
                View Details
            </a>
        </div>

        <!-- Missed Appointments -->
        <div class="bg-red-50 border border-red-200 rounded-xl p-6 shadow-md hover:shadow-lg hover:border-red-400 transition duration-300 print:hidden">
            <h2 class="text-xl font-semibold text-red-900 mb-2">Missed Appointments</h2>
            <p class="text-sm text-gray-700 mb-4">Track patients who missed their scheduled visits.</p>
            <p id="missedAppointments" class="text-4xl font-bold text-red-800 mb-4">0</p>
            <a href="/Appointments/Missed" class="inline-block px-4 py-2 bg-red-600 text-white text-sm font-semibold rounded hover:bg-red-700 transition">
                View Details
            </a>
        </div>


        <!-- Monthly Patient Report Card -->
        <div id="reportCard" class="bg-white shadow-md p-6 rounded mt-6 print:p-0 print:shadow-none print:border-none">
            <h2 class="text-xl font-semibold mb-4">Monthly Patient Report</h2>

            <!-- Filters -->
            <div class="flex gap-4 mb-4 print:flex print:gap-4">
                <select id="reportMonth" class="border rounded px-2 py-1 print:border-none">
                    <option value="1">January</option>
                    <option value="2">February</option>
                    <option value="3">March</option>
                    <option value="4">April</option>
                    <option value="5">May</option>
                    <option value="6">June</option>
                    <option value="7">July</option>
                    <option value="8">August</option>
                    <option value="9">September</option>
                    <option value="10">October</option>
                    <option value="11">November</option>
                    <option value="12">December</option>
                    <!-- ... -->
                </select>
                <select id="reportYear" class="border rounded px-2 py-1 print:border-none">
                    <option value="2025">2025</option>
                    <option value="2024">2024</option>
                </select>
                <button id="generateReportBtn" class="bg-blue-600 text-white px-4 py-1 rounded print:hidden">
                    Generate Report
                </button>
            </div>

            <!-- Report Table (never shown on screen, only in print) -->
            <div id="reportContainer" class="mt-6 hidden print:block print:w-full print:overflow-visible">
                <h3 id="reportTitle" class="text-lg font-semibold mb-2 text-gray-700 print:text-base print:font-semibold"></h3>
                <table class="table-auto w-full border border-gray-300 text-sm print:text-xs print:w-full">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-2 py-1 text-left">Patient Name</th>
                            <th class="px-2 py-1 text-left">Telephone</th>
                            <th class="px-2 py-1 text-left">Address</th>
                            <th class="px-2 py-1 text-left">Date of Visit</th>
                            <th class="px-2 py-1 text-left">Service</th>
                            <th class="px-2 py-1 text-left">Visit Status</th>
                            <th class="px-2 py-1 text-left">Debit</th>
                            <th class="px-2 py-1 text-left">Credit</th>
                            <th class="px-2 py-1 text-left">Balance</th>
                        </tr>
                    </thead>
                    <tbody id="reportTableBody"></tbody>
                </table>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard/index.js"></script>
    <script src="~/js/dashboard/report.js"></script>
}


