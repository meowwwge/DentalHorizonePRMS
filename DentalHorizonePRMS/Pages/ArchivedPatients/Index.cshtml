@page
@model DentalHorizonePRMS.Pages.ArchivedPatientsModel
@{
    ViewData["Title"] = "Archived Patients";
    Layout = "_Layout";
}

<div class="min-h-screen bg-gradient-to-br from-white via-gray-50 to-gray-100 text-gray-800 px-6 py-8 font-poppins">

    <!-- Header -->
    <div class="flex items-center gap-2 mb-8">
        <svg class="w-8 h-8 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-6h6v6m2 4H7a2 2 0 01-2-2V5a2 2 0 012-2h10a2 2 0 012 2v14a2 2 0 01-2 2z" />
        </svg>
        <h2 class="text-3xl font-bold text-gray-800">Archived Patients</h2>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto bg-white rounded-xl shadow-md border border-gray-200">
        <table id="archivedPatientsTable" class="min-w-full text-sm text-left text-gray-700 border-collapse border border-gray-300">
            <thead class="bg-gray-100 text-xs uppercase text-gray-600">
                <tr>
                    <th class="px-4 py-3 border border-gray-300">Name</th>
                    <th class="px-4 py-3 border border-gray-300">Age</th>
                    <th class="px-4 py-3 border border-gray-300">Occupation</th>
                    <th class="px-4 py-3 border border-gray-300">Telephone</th>
                    <th class="px-4 py-3 border border-gray-300">Address</th>
                    <th class="px-4 py-3 border border-gray-300">Status</th>
                    <th class="px-4 py-3 border border-gray-300">Patient Status</th>
                    <th class="px-4 py-3 border border-gray-300">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <!-- Dynamic rows will be injected here -->
            </tbody>
        </table>
    </div>

    <!-- Success Modal -->
    <div id="successModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md animate-fadeIn">
            <h3 class="text-lg font-bold text-green-600 mb-4">Success</h3>
            <p class="modal-message text-gray-700 mb-6"></p>
            <div class="text-right">
                <button onclick="closeSuccessModal()"
                        class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                    OK
                </button>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div id="errorModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md animate-fadeIn">
            <h3 class="text-lg font-bold text-red-600 mb-4">Error</h3>
            <p class="modal-message text-gray-700 mb-6"></p>
            <div class="text-right">
                <button onclick="closeErrorModal()"
                        class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/shared/modals.js"></script>
    <script src="~/js/archived-patients/index.js"></script>
}