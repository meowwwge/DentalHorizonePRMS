@page
@model DentalHorizonePRMS.Pages.ArchivedPatientsModel
@{
    ViewData["Title"] = "Archived Patients";
    Layout = "_Layout";
}
<h2 class="text-xl font-bold mb-4">Archived Patients</h2>

    <table id="archivedPatientsTable" class="w-full border-collapse">
        <thead>
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Occupation</th>
                <th>Telephone</th>
                <th>Address</th>
                <th>Status</th>
                <th>Patient Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <div id="successModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 hidden">
    <div class="bg-white rounded-lg shadow-lg p-6 w-96">
        <h3 class="text-lg font-bold text-green-600 mb-4">Success</h3>
        <p class="modal-message text-gray-700 mb-6"></p>
        <div class="text-right">
            <button onclick="closeSuccessModal()" 
                    class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">
                OK
            </button>
        </div>
    </div>
</div>

<div id="errorModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 hidden">
    <div class="bg-white rounded-lg shadow-lg p-6 w-96">
        <h3 class="text-lg font-bold text-red-600 mb-4">Error</h3>
        <p class="modal-message text-gray-700 mb-6"></p>
        <div class="text-right">
            <button onclick="closeErrorModal()" 
                    class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">
                Close
            </button>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/shared/modals.js"></script>
    <script src="~/js/archived-patients/index.js"></script>
}
